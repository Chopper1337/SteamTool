# Copy to .env (which is gitignored) and fill in.

# Bind address and port.
#
# If your web server runs in a container and the API runs on the host, the
# container cannot reach 127.0.0.1 — inside a container, loopback is the
# container. See deploy/README.md for the options.
HOST=127.0.0.1
PORT=3000

# Number of reverse proxies in front of the API. Without it, req.ip is the
# proxy's address for every visitor.
#
# Keep this at 0 unless the API port is reachable *only* by the proxy. Anything
# that can reach the API directly can forge X-Forwarded-For, so trusting hops
# would let a caller pick its own req.ip and walk past any IP-based limiting.
TRUST_PROXY_HOPS=0

# Required to view the API log in the site's Stats panel. Without it that
# endpoint is disabled, because the log contains the vanity names and
# SteamID64s of everyone who has used the tool.
#   openssl rand -hex 24
STATS_TOKEN=

# Where mutable state lives (visitor_count.txt, api.log). Defaults to the api/
# directory. The systemd unit sets this to /var/lib/steamtool; on first start
# the API copies any existing files across, leaving the originals as a backup.
# STEAMTOOL_STATE=/var/lib/steamtool

# Lines of API log retained and served to the stats panel.
# MAX_LOG_LINES=5000

# Restrict CORS to your own origin. Defaults to * for backwards compatibility.
# The frontend is same-origin through the proxy, so the wildcard buys nothing
# in production.
# STEAMTOOL_ORIGIN=https://example.com
